{
  "name": "ZPad",
  "identifier": "com.xiaoz.zpad",
  "version": "0.1.0",
  "out": "build",
  "i18n": {
    "dir": "locales",
    "source": "en"
  },
  "fileAssociations": [
    {
      "ext": ["txt", "md", "markdown", "html", "htm", "css", "json",
              "js", "mjs", "cjs", "ts", "tsx", "jsx", "xml",
              "yaml", "yml", "toml", "ini", "conf", "log", "csv"],
      "name": "Text Document",
      "mimeType": "text/plain"
    }
  ]
}
