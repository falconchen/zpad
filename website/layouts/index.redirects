{{- /*
  Cloudflare Pages reads _redirects from the deployment root. The short links
  follow the latest release at build time: the same data the download page
  uses, so there is no second version number to edit.
*/ -}}
{{- $release := partialCached "release.html" . "latest" -}}
{{- $assets := dict -}}
{{- with $release -}}{{- $assets = partial "release-assets.html" . -}}{{- end -}}
# Generated by Hugo from the latest GitHub release; do not edit.
{{ with $assets.macos_arm64 -}}
/download/mac-arm64  {{ .url }}  302
{{ end -}}
{{ with $assets.macos_amd64 -}}
/download/mac-intel  {{ .url }}  302
{{ end -}}
{{ with $assets.windows_setup -}}
/download/windows  {{ .url }}  302
{{ end -}}
{{ with $assets.windows_portable -}}
/download/windows-portable  {{ .url }}  302
{{ end -}}
{{ with $assets.linux_deb -}}
/download/linux  {{ .url }}  302
{{ end -}}
{{ with $assets.linux_rpm -}}
/download/linux-rpm  {{ .url }}  302
{{ end -}}
{{ with $assets.linux_tar -}}
/download/linux-tar  {{ .url }}  302
{{ end -}}
